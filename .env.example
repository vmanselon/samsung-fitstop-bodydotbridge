# Native-only secrets
BDOT_CLIENT_ID=
BDOT_CLIENT_SECRET=

# Optional first-launch kiosk ID. In-app changes are persisted.
BDOT_KIOSK_CLIENT_ID=

# HMAC secret for QR code generation. Must be the same as the server-side secret.
QR_SECRET=

# Frontend configuration (restart or rebuild after changing)
VITE_USE_MOCK_DATA=true
VITE_BDOT_LOG_SESSION=false
VITE_USE_MOCK_SAVE=true
VITE_API_BASE_URL=https://example.com/api