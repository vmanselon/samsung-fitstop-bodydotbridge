# Native-only BAS configuration (never add a VITE_ prefix)
BDOT_CLIENT_ID=
BDOT_CLIENT_SECRET=
QR_SECRET=development-only-secret
# Optional desktop first-launch override. Android defaults to this value, and the
# in-app setting is persisted after it is saved.
BDOT_KIOSK_CLIENT_ID=

# Frontend development and result-save configuration
VITE_USE_MOCK_DATA=true
VITE_USE_MOCK_SAVE=true
VITE_FITSTOP_SAVE_URL=https://api.example.com/api/bodydot/results
